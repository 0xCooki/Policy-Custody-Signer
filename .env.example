# HTTP
PORT=3000

# SQLite path (created at runtime later)
DATABASE_PATH=./data/custody.db

# Signer backend: local | softhsm | mock-mpc
SIGNER_BACKEND=local

# SoftHSM (SIGNER_BACKEND=softhsm). Prefer: docker compose up --build
# Host: ./scripts/init-softhsm.sh then paste SOFTHSM_* + SOFTHSM2_CONF here
SOFTHSM_MODULE_PATH=
SOFTHSM2_CONF=
SOFTHSM_PIN=1234
SOFTHSM_SLOT=0
SOFTHSM_KEY_LABEL=custody-eth

# Role-separated API keys (replace in real deploys)
API_KEY_INITIATORS=dev-initiator
API_KEY_APPROVERS=dev-approver
API_KEY_ADMINS=dev-admin

# Anvil 
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Dev only Anvil account #0
LOCAL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Policy
POLICY_MAX_VALUE=1000000000000000000
POLICY_ALLOWLIST=0x00000000000000000000000000000000000000c8
POLICY_QUORUM=1